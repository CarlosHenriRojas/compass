# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://seu-project-ref.supabase.co

# URL pública da aplicação. Use a URL de produção no deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# Somente no servidor. Necessária para administradores criarem usuários.
# Nunca prefixe esta variável com NEXT_PUBLIC_.
# Project Settings > API Keys > Secret key
SUPABASE_SECRET_KEY=sb_secret_substitua_aqui
